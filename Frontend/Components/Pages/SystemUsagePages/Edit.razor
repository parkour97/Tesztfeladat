@page "/systemusages/edit"
@using Microsoft.EntityFrameworkCore
@using Frontend.Models
@inject IDbContextFactory<Frontend.Data.FrontendContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>SystemUsage</h2>
<hr />
@if (SystemUsage is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="SystemUsage" OnValidSubmit="UpdateSystemUsage" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="SystemUsage.Id" value="@SystemUsage.Id" />
                <div class="mb-3">
                    <label for="deviceid" class="form-label">DeviceId:</label>
                    <InputNumber id="deviceid" @bind-Value="SystemUsage.DeviceId" class="form-control" />
                    <ValidationMessage For="() => SystemUsage.DeviceId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="devicename" class="form-label">DeviceName:</label>
                    <InputText id="devicename" @bind-Value="SystemUsage.DeviceName" class="form-control" />
                    <ValidationMessage For="() => SystemUsage.DeviceName" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="usage" class="form-label">Usage:</label>
                    <InputNumber id="usage" @bind-Value="SystemUsage.Usage" class="form-control" />
                    <ValidationMessage For="() => SystemUsage.Usage" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="timestamp" class="form-label">Timestamp:</label>
                    <InputDate id="timestamp" @bind-Value="SystemUsage.Timestamp" class="form-control" />
                    <ValidationMessage For="() => SystemUsage.Timestamp" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/systemusages">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private SystemUsage? SystemUsage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        SystemUsage ??= await context.SystemUsage.FirstOrDefaultAsync(m => m.Id == Id);

        if (SystemUsage is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateSystemUsage()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(SystemUsage!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!SystemUsageExists(SystemUsage!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/systemusages");
    }

    private bool SystemUsageExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.SystemUsage.Any(e => e.Id == id);
    }
}
