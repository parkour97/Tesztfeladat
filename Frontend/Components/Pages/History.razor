@page "/history"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>History</PageTitle>

<h1>Usage History</h1>

@if (SystemUsageHistory.Count == 0)
{
	<p><em>Loading...</em></p>
}
else
{
	<div class="row mb-3 align-items-end">
		<div class="col-md-3">
			<label class="form-label">Device</label>
			<select class="form-select" @bind="SelectedDeviceId">
				@foreach (var device in Devices)
				{
					<option value="@device.Id">@device.Name</option>
				}
			</select>
		</div>
		<div class="col-md-3">
			<label class="form-label">From</label>
			<input type="datetime-local" class="form-control" @bind="SelectedFrom" />
		</div>
		<div class="col-md-3">
			<label class="form-label">To</label>
			<input type="datetime-local" class="form-control" @bind="SelectedTo" />
		</div>
		<div class="col-md-3">
			<button class="btn btn-primary w-100" @onclick="ApplyFilters">
				Apply
			</button>
		</div>
	</div>

	<table class="table">
		<thead>
			<tr>
				<th>DeviceId</th>
				<th>Device Name</th>
				<th>Measurement Name</th>
				<th>Usage (%)</th>
				<th>Timestamp</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var usage in SystemUsageHistory)
			{
				<tr>
					<td>@usage.DeviceId</td>
					<td>@usage.DeviceName</td>
					<td>@usage.MeasurementName</td>
					<td>@usage.Usage</td>
					<td>@usage.Timestamp</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	private List<SystemUsageView> SystemUsageHistory = new();
	private PeriodicTimer? _timer;
	private bool _started;

	// UI változók
	private int SelectedDeviceId = 0;
	private DateTime SelectedFrom = DateTime.Now.Date.AddDays(-7);
	private DateTime SelectedTo = DateTime.Now.Date.AddHours(23).AddMinutes(59).AddSeconds(59);

	private int SetDeviceId = 0;
	private DateTime SetFrom = DateTime.Now.Date.AddDays(-7);
	private DateTime SetTo = DateTime.Now.Date.AddHours(23).AddMinutes(59).AddSeconds(59);


	private List<DeviceView> Devices = new()
	{
		new DeviceView(){Id = 0, Name = "All devices"},
		new DeviceView(){Id = 1, Name = "SystemMonitor" }
	};

	protected override async Task OnInitializedAsync()
	{
		//Console.WriteLine($"Init at {DateTime.Now}");
		await LoadDataAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		//Console.WriteLine($"OnAfterRenderAsync at {DateTime.Now}");
		if (!firstRender || _started)
			return;

		_started = true;

		//Console.WriteLine($"Interactive render at {DateTime.Now}");
		_timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

		_ = RunRefreshLoopAsync();
	}

	private async Task RunRefreshLoopAsync()
	{
		while (await _timer!.WaitForNextTickAsync())
		{
			await LoadDataAsync();
		}
	}

	private async Task ApplyFilters()
	{
		SetDeviceId = SelectedDeviceId;
		SetFrom = SelectedFrom;
		SetTo = SelectedTo;

		await LoadDataAsync();
	}

	private async Task LoadDataAsync()
	{
		//Console.WriteLine($"Reload at {DateTime.Now}");
		var names = new[] { "CPU Usage (%)", "Memory Usage (%)" };
		var startDate = DateTime.Now;

		SystemUsageHistory = Enumerable.Range(1, 10)
			.Select(index => new SystemUsageView
			{
				Id = index,
				Timestamp = startDate.AddMinutes(-index),
				Usage = Random.Shared.Next(0, 100),
				DeviceName = "SystemMonitor",
				DeviceId = 1 + Random.Shared.Next(names.Length),
				MeasurementName = names[Random.Shared.Next(names.Length)]
			})
			.Where(u =>
				(SelectedDeviceId == 0 || u.DeviceId == SetDeviceId) &&
				u.Timestamp >= SetFrom &&
				u.Timestamp <= SetTo)
			.ToList();

		await InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		_timer?.Dispose();
	}
}