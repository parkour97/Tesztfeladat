@page "/"
@attribute [Authorize]
@inject ApiClient ApiClient
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>

@if (deviceList.Count() == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Usage (%)</th>
                <th>LastUpdated</th>
                <th>IP Address</th>
                <th>Connected</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in deviceList)
            {
                <tr>
                    <td>@device.Name</td>
                    <td>
                        @foreach (var usage in device.Usages)
                        {
                            <div>
                                <strong>@usage.MeasurementName</strong>: @usage.Usage
                            </div>
                        }
                    </td>
                    <td>@device.LastUpdate</td>
                    <td>@device.IPAddress</td>
                    <td>@device.Connected</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DeviceView> deviceList = new List<DeviceView>();
    private PeriodicTimer? _timer;
    private bool _started;

    protected override async Task OnInitializedAsync()
    {
        //Console.WriteLine($"Init at {DateTime.Now}");
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //Console.WriteLine($"OnAfterRenderAsync at {DateTime.Now}");
        if (!firstRender || _started)
            return;

        _started = true;

        //Console.WriteLine($"Interactive render at {DateTime.Now}");
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        while (await _timer!.WaitForNextTickAsync())
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        deviceList.Clear();

        foreach (var item in await ApiClient.GetDevicesAsync())
        {
            deviceList.Add(item);
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}