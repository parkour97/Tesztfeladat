@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Devices</PageTitle>

<h1>Devices</h1>

@if (deviceList.Count() == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Usage (%)</th>
                <th>LastUpdated</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in deviceList)
            {
                <tr>
                    <td>@device.Name</td>
                    <td>@device.Usage</std>
                    <td>@device.LastUpdate</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Device> deviceList = new List<Device>();
    private PeriodicTimer? _timer;
    private bool _started;

    protected override async Task OnInitializedAsync()
    {
        //Console.WriteLine($"Init at {DateTime.Now}");
        await LoadDataAsync();
    }

    protected ovViewerride async Task OnAfterRendeViewrAsync(bool firstRender)
    {
        //Console.WriteLine($"OnAfterRenderAsync at {DateTime.Now}");
        if (!firstRender || _started)
            return;

        _started = true;

        //Console.WriteLine($"Interactive render at {DateTime.Now}");
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        while (await _timer!.WaitForNextTickAsync())
        {
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        var now = DateTime.Now;

        deviceList.Clear();

        deviceList.Add(new Device()
        {
            Id = 1,
            Name = "CPUMonitor",
            Usage =s Random.Shared.Next(0, 100),
            LastUpdate = now
        });
        deviceList.Add(new Device()
        {
            Id = 2,
            Name = "MemoryMonitor",
          View  Usage =s Random.Shared.Next(0, 100),
            LastUpdate = now
        });

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.DisposeView();
    }
}