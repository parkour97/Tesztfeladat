@page "/device-params"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthStateProvider AuthProvider
@implements IDisposable

<PageTitle>DeviceParams</PageTitle>

<h1>Device Parameters</h1>

@if (deviceParamList.Count() == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Device Name</th>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var deviceParam in deviceParamList)
            {
                <tr>
                    <td>@deviceParam.DeviceName</td>
                    <td>@deviceParam.Name</td>
                    <td>
                        <input type="number"
                               @bind="deviceParam.Value"
                               @bind:event="oninput"
                               class="form-control" />
                    </td>
                    <td>
                        <button class="btn btn-primary btn-sm"
                                @onclick="() => SubmitSingle(deviceParam)"
                                disabled="@isSubmitting">
                            @if (isSubmitting && currentSubmittingId == deviceParam.Id)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Submit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info mt-2">@StatusMessage</div>
    }
}

@code {
    private List<DeviceParamView> deviceParamList = new List<DeviceParamView>();
    private PeriodicTimer? _timer;
    private bool _started;

    private string? StatusMessage;

    private bool isSubmitting;
    private int? currentSubmittingId;

    protected override async Task OnInitializedAsync()
    {
        //Console.WriteLine($"Init at {DateTime.Now}");
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //Console.WriteLine($"OnAfterRenderAsync at {DateTime.Now}");
        if (!firstRender || _started)
            return;

        _started = true;

        //Console.WriteLine($"Interactive render at {DateTime.Now}");
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        while (await _timer!.WaitForNextTickAsync())
        {
            await LoadDataAsync();
        }
    }

    private async Task SubmitSingle(DeviceParamView deviceParam)
    {
        isSubmitting = true;
        currentSubmittingId = deviceParam.Id;
        StateHasChanged();  // UI frissítés (spinner)

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;

            var success = await ApiClient.SetDeviceParameterAsync(deviceParam.Id, deviceParam.Value, userName);

            StatusMessage = success
                ? $"[{deviceParam.Name}] Value sent successfully!"
                : $"[{deviceParam.Name}] Failed to send value.";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            currentSubmittingId = null;
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        deviceParamList.Clear();
        foreach (var item in await ApiClient.GetDeviceParamsAsync())
        {
            deviceParamList.Add(item);
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
