@page "/device-params"
@rendermode InteractiveServer
@* @inject ApiClient ApiClient *@
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>DeviceParams</PageTitle>

<h1>Device Parameters</h1>

@if (deviceParamList.Count() == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Device Name</th>
                <th>Name</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var deviceParam in deviceParamList)
            {
                <tr>
                    <td>@deviceParam.DeviceName</td>
                    <td>@deviceParam.Name</td>
                    <td><input type="number" @bind="deviceParam.Value" @bind:event="oninput" /></td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary" @onclick="Submit">Submit</button>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="alert alert-info mt-2">@StatusMessage</div>
    }
}

@code {
    private List<DeviceParam> deviceParamList = new List<DeviceParam>();
    private PeriodicTimer? _timer;
    private bool _started;

    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        //Console.WriteLine($"Init at {DateTime.Now}");
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        //Console.WriteLine($"OnAfterRenderAsync at {DateTime.Now}");
        if (!firstRender || _started)
            return;

        _started = true;

        //Console.WriteLine($"Interactive render at {DateTime.Now}");
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(10));

        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        while (await _timer!.WaitForNextTickAsync())
        {
            await LoadDataAsync();
        }
    }

    private async void Submit()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            StatusMessage = "User is not logged in.";
            return;
        }

        var username = user.Identity?.Name ?? "UnknownUser";
        foreach (var deviceParam in deviceParamList)
        {
            //var success = await ApiClient.SetDeviceParameterAsync(deviceParam.Id, deviceParam.Value, username);

            // StatusMessage = success ? "Value sent successfully!" : "Failed to send value.";
        }
    }

    private async Task LoadDataAsync()
    {
        deviceParamList.Clear();
        deviceParamList.Add(new DeviceParam()
        {
            Id = 1,
            Name = "Interval",
            Value = 5,
            DeviceId = 1,
            DeviceName = "SystemMonitor"
        });
        deviceParamList.Add(new DeviceParam()
        {
            Id = 2,
            Name = "Queue_size",
            Value = 64,
            DeviceId = 1,
            DeviceName = "SystemMonitor"
        });

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
