@page "/log-in"
@inject ApiClient ApiClient
@inject AuthStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>LogIn</PageTitle>

<h3>LogIn</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Username or Email</label>
        <InputText @bind-Value="loginModel.UsernameOrEmail" class="form-control" />
        <ValidationMessage For="@(() => loginModel.UsernameOrEmail)" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
        <ValidationMessage For="@(() => loginModel.Password)" />
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>

<p>
    Not registered yet?
    <a href="/register">Register here</a>
</p>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

@code {
    private LoginModel loginModel = new LoginModel();
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        ErrorMessage = null;

        var token = await ApiClient.LoginAsync(loginModel.UsernameOrEmail, loginModel.Password);
        if (token != null)
        {
            AuthProvider.MarkUserAsAuthenticated(loginModel.UsernameOrEmail);
            Nav.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Invalid username or password!";
        }
    }
}
